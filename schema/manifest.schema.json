{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://registry.skinloom.cn/schema/manifest.schema.json",
  "title": "SkinLoom Registry Package Manifest",
  "type": "object",
  "required": [
    "id",
    "kind",
    "runtime",
    "category",
    "name",
    "description",
    "authors",
    "license",
    "repository",
    "releases"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,38}[a-z0-9]$",
      "description": "Unique kebab-case plugin or theme identifier"
    },
    "kind": {
      "type": "string",
      "enum": ["plugin", "theme"]
    },
    "runtime": {
      "type": "string",
      "enum": ["js", "native"],
      "default": "js"
    },
    "category": {
      "type": "string",
      "enum": ["security", "auth", "score", "economy", "operations", "migration", "storage", "render", "search", "theme", "utility"]
    },
    "official": {
      "type": "boolean",
      "default": false
    },
    "name": {
      "type": "object",
      "required": ["zh-CN", "en"],
      "properties": {
        "zh-CN": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": { "type": "string" }
    },
    "description": {
      "type": "object",
      "required": ["zh-CN", "en"],
      "properties": {
        "zh-CN": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": { "type": "string" }
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "repository": {
      "type": "string",
      "format": "uri"
    },
    "subdir": {
      "type": "string",
      "description": "Optional relative directory inside repository containing plugin.json"
    },
    "releases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["version", "commit", "apiVersion"],
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
          },
          "tag": {
            "type": "string"
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$",
            "description": "Immutable 40-hex Git commit SHA to check out and compile"
          },
          "apiVersion": {
            "type": "integer",
            "const": 1
          },
          "nativeProtocolVersion": {
            "type": "integer",
            "const": 1
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "linux/amd64",
                "linux/arm64",
                "windows/amd64",
                "darwin/arm64",
                "darwin/amd64"
              ]
            }
          },
          "engines": {
            "type": "object",
            "properties": {
              "skinloom": { "type": "string" },
              "go": { "type": "string" }
            }
          },
          "permissions": {
            "type": "array",
            "items": { "type": "string" }
          },
          "dependencies": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "optionalDependencies": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "changelog": {
            "type": "string"
          },
          "publishedAt": {
            "type": "string"
          },
          "yanked": {
            "type": "boolean",
            "default": false
          }
        }
      }
    }
  }
}
